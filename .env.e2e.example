# =============================================================================
# Isolated Supabase for PIN-login Playwright E2E (gitignored copy: .env.e2e.local)
# =============================================================================
# 1. Create a NEW Supabase project in the dashboard (do not reuse hlpojfurfldvcxfxhveg).
# 2. Copy this file to .env.e2e.local and fill keys from that project's Settings → API.
# 3. Set E2E_EXPECTED_REF to the project ref from the dashboard URL (positive ID check).
# 4. Apply Yike migrations to that project only after verify-e2e-supabase-target passes.
# 5. Never commit .env.e2e.local or paste service_role keys in chat.
#
# Load for E2E + dev server:
#   set -a && source .env.e2e.local && set +a
#   node scripts/verify-e2e-supabase-target.mjs
#   npm run dev
#   E2E_ISOLATED_SUPABASE=1 PLAYWRIGHT_SKIP_SERVER=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 \
#     npx playwright test e2e/pin-login-qa-verification.spec.ts

E2E_EXPECTED_REF=your-non-production-project-ref

NEXT_PUBLIC_SUPABASE_URL=https://your-non-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-non-production-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate a random secret; insert matching row in E2E project yike_internal_config (key otp_server_token)
YIKE_OTP_SERVER_TOKEN=generate-a-long-random-string

# Playwright / Next dev (match local preview rules)
APP_ENV=development
YIKE_PIN_PEPPER=local-e2e-pin-pepper-minimum-32-characters

# Optional: consumer navigation / messaging E2E (non-production only)
# E2E_EPHEMERAL_AUTH=1
# E2E_CONSUMER_EMAIL=
# E2E_CONSUMER_PASSWORD=

# Optional: staff role route smoke — one pair per role (never commit)
# E2E_STAFF_MODERATOR_EMAIL=  E2E_STAFF_MODERATOR_PASSWORD=
# E2E_STAFF_CONTENT_EMAIL=    E2E_STAFF_CONTENT_PASSWORD=
# E2E_STAFF_CAREERS_EMAIL=    E2E_STAFF_CAREERS_PASSWORD=
# E2E_STAFF_SUPPORT_EMAIL=    E2E_STAFF_SUPPORT_PASSWORD=
# E2E_STAFF_TECH_EMAIL=       E2E_STAFF_TECH_PASSWORD=
# E2E_STAFF_ADMIN_EMAIL=      E2E_STAFF_ADMIN_PASSWORD=
