# =============================================================================
# Yike — environment variables
# Copy to .env.local for dev. Set the same keys in Coolify runtime environment (production).
# =============================================================================

# --- Required (production + local) ---
# Supabase → Project Settings → API
# https://supabase.com/dashboard/project/hlpojfurfldvcxfxhveg/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://hlpojfurfldvcxfxhveg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Required for signup + admin APIs (server-only — never NEXT_PUBLIC_) ---
# Mirror host for scripts/tests (same ref as NEXT_PUBLIC_SUPABASE_URL):
# SUPABASE_URL=https://hlpojfurfldvcxfxhveg.supabase.co
# Supabase → Project Settings → API → service_role (secret) or secret API key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local only: apply migrations (npm run db:push) ---
# Supabase → Account → Access Tokens (needs access to project hlpojfurfldvcxfxhveg)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=hlpojfurfldvcxfxhveg
#
# --- Development database (gitignored .env.local — canonical ref hlpojfurfldvcxfxhveg) ---
# Pre-launch: local dev and integration tests use the linked Yike Supabase project above.
# Before db push: npm run verify:supabase-project -- --require-linked && npm run verify:dev-target
# ALLOW_PRODUCTION_DB_PUSH=1 npm run db:push   # ack — mutates linked dev DB; inspect migrations first
# DB integration tests: YIKE_DEV_DB_INTEGRATION=1 npm run test:dev:integration
# Optional stable test profile: YIKE_DEV_TEST_USER_ID=<existing profiles.id uuid>
# Local sample consumer (scripts/create-sample-consumer.ts — requires service role + OTP token):
# YIKE_SAMPLE_CONSUMER_EMAIL=you@example.com
# YIKE_SAMPLE_CONSUMER_PHONE=08012345678
# YIKE_CREDENTIALS_FILE=.local-test-credentials.txt

# --- Phone OTP server token (server-only; auto-generated — must match Supabase yike_internal_config) ---
YIKE_OTP_SERVER_TOKEN=your-otp-server-token

# --- Phone OTP (Sendchamp only — server-only) ---
# Seller phone verify uses SMS (WhatsApp OTP removed). Auth email OTP remains browse-first default.
# https://app.sendchamp.com → Account Settings → Public access key + Live Base URL
# Docs: https://sendchamp.readme.io/reference/introduction
# Sendchamp → Account → APIs & webhooks → Access key (Bearer on Verification API)
SENDCHAMP_API_KEY=your-sendchamp-access-key
# Legacy alias — prefer SENDCHAMP_API_KEY; live keys often start with sendchamp_live_
SENDCHAMP_PUBLIC_KEY=
SENDCHAMP_LIVE_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_WEBHOOK_URL=https://yike.ng/api/webhooks/sendchamp
# Phone OTP channel: sms (WhatsApp scrapped for OTP)
SENDCHAMP_OTP_CHANNEL=sms
SENDCHAMP_OTP_EXPIRY_MINUTES=30
SENDCHAMP_OTP_LENGTH=6
# Approved SMS sender ID (production: YIKE)
# SMS route for branded /sms/send diagnostics only (single route — never multi-spray).
# SENDCHAMP_SMS_ROUTE=dnd
SENDCHAMP_SMS_SENDER=YIKE
# Local only: send real Sendchamp SMS from /agent/verify (no terminal OTP fallback). One manual test at a time.
# YIKE_REAL_SMS_TEST=true

# Temporary OTP delivery audit logs (Coolify). Default on until investigation closes.
# OTP_DELIVERY_AUDIT=true
# OTP_DELIVERY_AUDIT_REDACT=true

# Legacy WhatsApp sender field — unused when OTP is SMS-only
SENDCHAMP_WHATSAPP_SENDER=

# --- Auth verification flags (email-first browse; SMS OTP for seller phone verify) ---
# Production: ENABLE_PHONE_OTP + ENABLE_SMS_OTP on (Sendchamp SMS Verification, sender YIKE).
ENABLE_PHONE_OTP=true
ENABLE_SMS_OTP=true
SENDCHAMP_OTP_LENGTH=6
SENDCHAMP_OTP_EXPIRY_MINUTES=30
ENABLE_EMAIL_OTP=true
#
# FAT / testing only — temporary SMS bypass (default when unset = true = SMS required).
# Set false on staging (or a controlled FAT window) to skip SMS and mark phone verified.
# Before public launch: AUTH_SMS_VERIFICATION_ENABLED=true + one real SMS end-to-end test.
# AUTH_SMS_VERIFICATION_ENABLED=true
#
# Client UI — mirrors ENABLE_PHONE_OTP for seller phone verification
NEXT_PUBLIC_ENABLE_PHONE_OTP=true
# --- WhatsApp lead gateway (server-only) ---
# Route listing WhatsApp taps through Yike first → /l/[ref] handoff → agent
YIKE_LEAD_GATEWAY_ENABLED=true
# Official Yike WhatsApp line (defaults to SENDCHAMP_WHATSAPP_SENDER if unset)
YIKE_WHATSAPP_NUMBER=2348035143299
# Public support line (defaults to YIKE_SUPPORT_WHATSAPP constant if unset)
# NEXT_PUBLIC_YIKE_SUPPORT_WHATSAPP=2348035143299
# Phased direct-to-agent routing (launch default: off — Yike-first concierge)
ENABLE_DIRECT_AGENT_WHATSAPP=false
# Direct agent phone calls via call icon (launch default: off — WhatsApp-first)
ENABLE_DIRECT_AGENT_CALLS=false
# WhatsApp Cloud API auto-reply to leads (launch default: off — human concierge)
ENABLE_WHATSAPP_LEAD_AUTOREPLY=false
# Agent pay-per-lead billing deductions (launch default: off — records charge_amount only)
ENABLE_AGENT_LEAD_BILLING=false
# Home & relocation services marketplace (launch default: off — internal prep only)
ENABLE_HOME_SERVICES=false
NEXT_PUBLIC_ENABLE_HOME_SERVICES=false
# Featured listing promotions — UI on; set PAYMENTS true when Paystack keys are set
ENABLE_FEATURED_LISTINGS=true
ENABLE_FEATURED_PAYMENTS=false
NEXT_PUBLIC_ENABLE_FEATURED_LISTINGS=true
# Paystack (server secret only — never expose secret to client)
# Webhook auth uses PAYSTACK_SECRET_KEY + x-paystack-signature (HMAC-SHA512) — no separate webhook secret
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Browser return URL after Checkout — Processing page only (no activation)
PAYSTACK_CALLBACK_URL=https://yike.ng/payments/callback
# Preferred webhook URL for Paystack dashboard (also aliased at /api/webhooks/paystack)
PAYSTACK_WEBHOOK_URL=https://yike.ng/api/payments/webhook
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_CURRENCY=NGN
# Active gateway: paystack | safehaven | flutterwave | monnify | stripe | wallet
PAYMENT_GATEWAY=paystack
# Legacy alias for PAYMENT_GATEWAY (kept for compatibility)
PAYMENT_PROVIDER=paystack
# System default lead price in NGN when agent/listing price unset (optional)
# YIKE_DEFAULT_LEAD_PRICE=500
# Required in production when Sendchamp webhooks are used — fail-closed if unset
# Append ?secret=... to webhook URL or send x-yike-webhook-secret / x-sendchamp-webhook-secret
SENDCHAMP_WEBHOOK_SECRET=your-webhook-secret

# --- Transactional email (Resend — server-only) ---
# https://resend.com/api-keys
# 1. Verify yike.ng in Resend → Domains (DKIM/MX/TXT in Cloudflare)
# 2. All outbound mail sends from hello@yike.ng (see src/lib/email/from-address.ts)
RESEND_API_KEY=re_your-resend-api-key
# Optional override — must use hello@yike.ng; defaults to Yike <hello@yike.ng>
AUTH_EMAIL_FROM=Yike <hello@yike.ng>
# Legacy alias (same value as AUTH_EMAIL_FROM if set)
RESEND_FROM_EMAIL=Yike <hello@yike.ng>
# Internal moderation alerts
ADMIN_ALERT_EMAIL=hello@yike.ng

# --- Agent NIN verification (optional — Dojah recommended for MVP) ---
# DOJAH_APP_ID=your-dojah-app-id
# DOJAH_SECRET_KEY=your-dojah-secret-key
# ENCRYPTION_SECRET=32-char-minimum-secret-for-nin-encryption

# --- Marketplace verticals / launch mode ---
# Vehicle marketplace is the Day-1 flagship (always ON).
# ENABLE_VEHICLE_MARKETPLACE is legacy/ignored — do not set it to false on Coolify.
# Emergency hide only (hides /vehicles + create): ENABLE_VEHICLE_MARKETPLACE_EMERGENCY_OFF=true
# ENABLE_VEHICLE_MARKETPLACE_EMERGENCY_OFF=false

# Enterprise media protection (listing photos) — default ON
ENABLE_MEDIA_PROTECTION=true
# ENABLE_INTELLIGENT_WATERMARK_PLACEMENT=false
# MEDIA_WM_CORNER_OPACITY_MIN=0.12
# MEDIA_WM_CORNER_OPACITY_MAX=0.18
# MEDIA_WM_PATTERN_OPACITY_MIN=0.02
# MEDIA_WM_PATTERN_OPACITY_MAX=0.03
# MEDIA_WM_PATTERN_GAP=200
# MEDIA_PROTECTION_PIPELINE_VERSION=1.0.0
# MEDIA_WATERMARK_VERSION=1.0.0
# Strict launch mode hides deferred surfaces (passport UI, wallet, escrow, …)
# YIKE_LAUNCH_MODE=true
# Hide local [DEMO] UI fixtures even in development (empty rails instead)
# YIKE_DISABLE_DEMO_UI=1
# ENABLE_PASSPORT_UI=false
# ENABLE_ESCROW=false

# --- Financial Platform (YIP capability — configuration-only activation) ---
# Master payments switch (also honors legacy ENABLE_FEATURED_PAYMENTS)
# ENABLE_PAYMENTS=false
# ENABLE_FEATURED_PAYMENTS=false
# ENABLE_WALLET=false
# Full marketplace (Coolify — enable when credentials are live):
# ENABLE_YIKE_COINS=true
# Optional staging override for top-up pack amounts (NGN, comma-separated):
# YIKE_COIN_TOPUP_PACKS_NGN=500,1000,2000
# Non-production defaults enable coins when unset; force off with ENABLE_YIKE_COINS=false
# Dev-only self-serve test credits (POST /api/dev/yike-coins/test-credit — never works in production):
# YIKE_DEV_COIN_TEST_CREDIT=true
# YIKE_DEV_COIN_TEST_CREDIT_MAX=5000
# ENABLE_WALLET=true
# ENABLE_PAYMENTS=true
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_ENABLE_MARKETPLACE_NATIVE_CONTACT=true
# ENABLE_CONVERSATION_PLATFORM_V1=true
# ENABLE_VIDEO_CALL_BETA=true
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# NEXT_PUBLIC_AGORA_APP_ID=   # same App ID as AGORA_APP_ID — required for browser RTC join
# Video calls use Agora RTC; HTTPS or localhost required for camera/mic. Free allowance: 3/day (see yike-coins/constants).
# ENABLE_SETTLEMENT=false
# ENABLE_PROMOTIONS=false
# ENABLE_SUBSCRIPTIONS=false
# ENABLE_COMMISSIONS=false
# ENABLE_REFUNDS=true

# --- Search engine verification (optional — paste meta tag content from consoles) ---
# Google Search Console → HTML tag method
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → meta tag
# Optional override — default is baked into layout for yike.ng
BING_SITE_VERIFICATION=02902039559EB4CCB652E858CBFF27B8

# --- Local scripts only (seed) — do not add to production unless running seeds in CI ---
# SUPABASE_URL=https://hlpojfurfldvcxfxhveg.supabase.co

# --- Safe Haven / Sudo (server-only — preparation mode) ---
# Keep ENABLE_SAFEHAVEN=false until credentials are complete and manually approved.
ENABLE_SAFEHAVEN=false
ENABLE_SAFEHAVEN_VA=false
ENABLE_SAFEHAVEN_TRANSFERS=false
ENABLE_SAFEHAVEN_WEBHOOKS=true
SAFEHAVEN_ENV=production
SAFEHAVEN_CLIENT_ID=
# SAFEHAVEN_BASE_URL=
# SAFEHAVEN_CLIENT_SECRET=
# SAFEHAVEN_PRIVATE_KEY_BASE64=
# SAFEHAVEN_WEBHOOK_SECRET=
# SAFEHAVEN_BUSINESS_ID=
# SAFEHAVEN_SETTLEMENT_ACCOUNT=0118595995
# Optional path overrides when Safe Haven docs are finalized
# SAFEHAVEN_OAUTH_TOKEN_PATH=/oauth2/token
# SAFEHAVEN_VA_CREATE_PATH=/virtual-accounts
# SAFEHAVEN_WEBHOOK_SIGNATURE_HEADER=x-safehaven-signature

# --- PIN / session security (server-only) ---
# Pepper mixed into PIN hashes — never expose to client
# REQUIRED in production: random secret ≥32 characters (launch blocker — fail-fast)
YIKE_PIN_PEPPER=your-long-random-pepper-min-32-chars
# Optional dedicated HMAC secret for step-up tokens (falls back to CRON_SECRET)
# SENSITIVE_TOKEN_SECRET=
ENABLE_WEBAUTHN=false
ENABLE_STEP_UP_PAYOUTS=true
ENABLE_STRICT_DEVICE_BINDING=true

# --- Scheduled jobs (Coolify cron sidecar) — server-only ---
# GET /api/cron/* with Authorization: Bearer <CRON_SECRET> or x-cron-secret header
CRON_SECRET=your-cron-secret

# --- Runtime (Coolify / Docker) ---
# APP_ENV=production
# DEPLOY_PLATFORM=coolify
# DEPLOY_PROVIDER=hetzner
# APP_VERSION=0.1.0
# GIT_COMMIT_SHA=...  (optional — surfaced on /api/public-health)
# BUILD_TIME=2026-07-21T12:00:00.000Z
# NODE_ENV=production
# LOG_LEVEL=info
# Development/test only: opt in before rendering empty-inventory fixture cards.
# Never set this in production.
# YIKE_EMPTY_INVENTORY_FIXTURES=1
# Dev only: load the 30-item sample catalog when DB inventory is empty (never production).
# YIKE_SAMPLE_LISTINGS_FIXTURE=1
# YIKE_SAMPLE_LISTINGS_FIXTURE_FORCE=1

# --- Supabase Auth redirect URLs (dashboard, not env vars) ---
# Authentication → URL configuration:
#   Site URL: https://yike.ng
#   Redirect URLs: https://yike.ng/auth/callback, http://localhost:3000/auth/callback
