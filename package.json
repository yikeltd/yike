{
  "name": "yike",
  "version": "0.1.0",
  "private": true,
  "description": "Yike.ng — Stankings Marketplace Platform (property launch · vehicles pending)",
  "homepage": "https://yike.ng",
  "scripts": {
    "optimize:brand": "node scripts/optimize-brand-assets.mjs",
    "optimize:crew": "node scripts/optimize-crew-app-icon.mjs",
    "optimize:onboarding": "node scripts/optimize-onboarding-assets.mjs",
    "optimize:seller-plans": "node scripts/optimize-seller-plan-assets.mjs",
    "generate:crew-twa": "node scripts/generate-crew-twa-assets.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "twa:init": "cd twa && npx @bubblewrap/cli init --manifest=https://yike.ng/manifest.json",
    "twa:build": "bash twa/build-release.sh",
    "twa:verify": "node scripts/verify-twa-assetlinks.mjs",
    "twa-staff:init": "cd twa-staff && npx @bubblewrap/cli init --manifest=https://yike.ng/staff/manifest.json",
    "twa-staff:build": "npm run generate:crew-twa && bash twa-staff/build-release.sh",
    "heroes:generate": "node scripts/generate-hero-images.mjs",
    "careers:publish-content-seo": "node scripts/publish-content-seo-writer-job.mjs",
    "verify:supabase-project": "node scripts/verify-supabase-project.mjs",
    "supabase:verify": "node scripts/verify-supabase-project.mjs --require-linked",
    "supabase:link": "node scripts/verify-supabase-project.mjs && supabase link --project-ref hlpojfurfldvcxfxhveg",
    "supabase:migration:new": "node scripts/verify-supabase-project.mjs --require-linked && supabase migration new",
    "supabase:db:push": "node scripts/verify-supabase-project.mjs --require-linked && supabase db push",
    "supabase:db:reset": "node scripts/verify-supabase-project.mjs --require-linked && supabase db reset",
    "supabase:db:diff": "node scripts/verify-supabase-project.mjs --require-linked && supabase db diff",
    "supabase:db:pull": "node scripts/verify-supabase-project.mjs --require-linked && supabase db pull",
    "supabase:db:repair": "node scripts/verify-supabase-project.mjs --require-linked && supabase migration repair",
    "supabase:seed": "node scripts/verify-supabase-project.mjs --require-linked && supabase db seed",
    "db:push": "bash scripts/apply-supabase-migrations.sh",
    "db:push:staging": "bash scripts/db-push-staging.sh",
    "db:status": "node scripts/verify-supabase-project.mjs --require-linked && supabase migration list",
    "verify:dev-target": "node scripts/verify-dev-supabase-target.mjs",
    "compare:migrations": "node scripts/compare-local-migration-history.mjs",
    "verify:e2e-supabase": "node scripts/verify-e2e-supabase-target.mjs",
    "verify:staging-target": "node scripts/verify-staging-supabase-target.mjs",
    "test:dev:integration": "tsx --test scripts/staging-integration/**/*.test.ts",
    "test:staging:integration": "tsx --test scripts/staging-integration/**/*.test.ts",
    "admin:ensure": "node scripts/ensure-admin-user.mjs",
    "consumer:create-sample": "tsx scripts/create-sample-consumer.ts",
    "reviewer:ensure": "node scripts/ensure-reviewer-users.mjs",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" next build",
    "start": "next start",
    "lint": "eslint",
    "seed:sql": "node scripts/verify-supabase-project.mjs --require-linked && tsx scripts/seed-supabase.ts --sql",
    "seed": "node scripts/verify-supabase-project.mjs --require-linked && tsx scripts/seed-supabase.ts",
    "seed:demo": "tsx scripts/seed-demo-marketplace.ts",
    "seed:demo:dry": "tsx scripts/seed-demo-marketplace.ts --dry-run",
    "seed:sample-listings": "tsx scripts/seed-sample-listings.ts",
    "seed:sample-listings:dry": "tsx scripts/seed-sample-listings.ts --dry-run",
    "test:sample-listings": "tsx --test src/lib/__tests__/sample-listings-catalog.test.ts src/lib/__tests__/sample-listings-query-fixtures.test.ts",
    "test:latest-on-yike": "tsx --test src/lib/__tests__/latest-on-yike-feed.test.ts",
    "domain:dns": "bash scripts/setup-yike-domain-dns.sh",
    "domain:verify": "bash scripts/verify-yike-domain.sh",
    "email:assets": "node scripts/generate-email-assets.mjs && npx tsx scripts/render-email-previews.ts",
    "e2e:nav-prereqs": "tsx scripts/e2e-navigation-prerequisites.ts",
    "e2e:nav-prereqs:isolated": "E2E_ISOLATED_SUPABASE=1 tsx scripts/e2e-navigation-prerequisites.ts",
    "test:e2e:navigation": "E2E_ISOLATED_SUPABASE=1 E2E_EPHEMERAL_AUTH=1 PLAYWRIGHT_SKIP_SERVER=1 playwright test e2e/authenticated-navigation.spec.ts e2e/conversation-thread-navigation.spec.ts e2e/staff-role-routes.spec.ts",
    "test:e2e:marketplace": "PLAYWRIGHT_SKIP_SERVER=1 playwright test e2e/marketplace-routes-smoke.spec.ts e2e/marketplace-browse-navigation.spec.ts e2e/seller-journey-gates.spec.ts e2e/unified-search-integration.spec.ts e2e/discover-navigation.spec.ts e2e/consumer-shell-connectivity.spec.ts e2e/listing-leads-capture-auth.spec.ts",
    "notifications:test": "node scripts/test-sendchamp.mjs",
    "store:capture": "node scripts/capture-play-screenshots.mjs",
    "store:capture:1440": "SCREENSHOT_WIDTH=1440 SCREENSHOT_HEIGHT=3200 node scripts/capture-play-screenshots.mjs",
    "store:capture:tablet-7": "TABLET_SIZE=7 node scripts/capture-play-tablet-screenshots.mjs",
    "store:capture:tablet-10": "TABLET_SIZE=10 node scripts/capture-play-tablet-screenshots.mjs",
    "store:capture:tablet": "TABLET_SIZE=both node scripts/capture-play-tablet-screenshots.mjs",
    "test:auth": "tsx scripts/test-auth-security.ts",
    "test:safe-next-path": "tsx --test src/lib/__tests__/safe-next-path.test.ts",
    "test:media-protection": "tsx --test src/lib/media/protection/protection.test.ts",
    "test:listing-engine": "tsx --test src/lib/listing-engine/__tests__/engine.test.ts",
    "test:yip": "tsx --test src/lib/yip/__tests__/*.test.ts",
    "test:review-memory": "tsx scripts/test-review-memory.ts",
    "test:outcome-intelligence": "tsx scripts/test-outcome-intelligence.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_PORT=3000 playwright test",
    "test:e2e:reuse-dev": "PLAYWRIGHT_SKIP_SERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000 playwright test",
    "test:approval-pipeline": "tsx --test src/lib/__tests__/listing-approval-pipeline.test.ts",
    "test:universal-listing": "tsx --test src/lib/__tests__/universal-listing-foundation.test.ts",
    "test:electronics-vertical": "tsx --test src/lib/__tests__/electronics-vertical-qa.test.ts",
    "test:smart-filter": "tsx --test src/lib/__tests__/smart-filter-engine.test.ts",
    "test:vehicle-taxonomy": "tsx --test src/lib/__tests__/vehicle-taxonomy.test.ts",
    "test:mixed-marketplace": "tsx --test src/lib/__tests__/mixed-marketplace-search.test.ts",
    "test:seller-routes": "tsx --test src/lib/__tests__/seller-listing-routes.test.ts src/lib/__tests__/seller-onboarding-gates.test.ts",
    "test:yike-coins": "tsx --test src/lib/__tests__/yike-coins.test.ts src/lib/__tests__/yike-coins-hardening.test.ts",
    "test:native-contact": "tsx --test src/lib/__tests__/native-contact-safety.test.ts",
    "test:video-call-lifecycle": "tsx --test src/lib/__tests__/video-call-lifecycle.test.ts",
    "test:payments": "tsx --test src/lib/payments/**/__tests__/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "agora-access-token": "^2.0.4",
    "agora-rtc-sdk-ng": "^4.23.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.52.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.28",
    "source-map-js": "1.2.2"
  }
}
